# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# Server Configuration (Unified single-origin URL: http://localhost:3000)
PORT=3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=foodrescue_db

# JWT Secret Key (use a long random string in production)
JWT_SECRET=foodrescue_super_secret_jwt_key_2024

# Client URL (for CORS during development)
CLIENT_URL=http://localhost:3000
